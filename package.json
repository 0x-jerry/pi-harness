{
  "name": "@0x-jerry/pi-package",
  "version": "0.1.1",
  "description": "My personalized pi package: extensions, skills, prompts, and themes",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": ["src"],
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/extensions/index.ts"
    ],
    "prompts": [
      "./src/prompts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "release": "x-release"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.3.12"
  },
  "devDependencies": {
    "@0x-jerry/x-release": "^3.0.5",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lru-cache": "^11.5.2"
  }
}
